# Server Port
PORT=3000

# Meta WhatsApp Cloud API Configuration
# Get your Access Token from Meta Developer Console (WhatsApp -> API Setup)
WHATSAPP_TOKEN="your_meta_access_token_here"

# Phone Number ID from Meta Dashboard
PHONE_NUMBER_ID="893818507150447"

# Meta Graph API Version
API_VERSION="v22.0"

# Recipient Phone Number (Must include country code, e.g. +8801310861071 or 8801310861071)
TO="+8801310861071"

# Template Message Settings
TEMPLATE_NAME="hello_world"
TEMPLATE_LANG="en_US"
